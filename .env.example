# ── Authentication ──────────────────────────────────────────
# Required: Secret for signing session tokens (min 32 characters)
BETTER_AUTH_SECRET=this_is_a_secret_key_that_should_be_changed_and_is_at_least_32_characters_long
# Required: Base URL of your app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# ── Admin User (seeded on first run) ───────────────────────
# Backoffice operator. Admins are redirected to /backoffice and cannot open the
# finance app — use the seeded demo user below for that.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Admin

# ── Demo User (created by `npm run db:seed`) ──────────────
# Regular user that owns the dummy data. This is the one you log in as.
SEED_USERNAME=demo
SEED_PASSWORD=demo

# ── Transactional email (Resend) ──────────────────────────
# Required in production for signup verification + password reset emails.
# Leave unset locally — mail contents are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM="FinTrack <noreply@yourdomain.com>"
# Inbox that in-product feedback is delivered to. Unset = the feature returns 503.
FEEDBACK_EMAIL=

# ── Monitoring (Sentry) ───────────────────────────────────
# Leave all empty to disable Sentry entirely (local default).
# DSN enables error tracking, logs, and tracing on server + client.
NEXT_PUBLIC_SENTRY_DSN=
# Org slug, project slug, and auth token are only used at build time to upload
# source maps; without them the build succeeds but stack traces stay minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── File storage (avatars + receipts) ─────────────────────
# Stored on local disk, never served directly: every read goes through an
# authenticated route. Default: data/files (next to the SQLite database).
# FILE_STORAGE_DIR=

# ── Database (Turso) ──────────────────────────────────────
# Leave unset for local development (uses SQLite file at data/finance.db)
# Set both for production deployment with Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Bank sync (Enable Banking) ────────────────────────────
# Bank sync runs in a separate worker process that alone holds the master key
# encrypting users' bank keys. NEVER put the key, or its path, in this file:
# the web app reads .env too, and refuses to start in production when it can
# see the key. Locally, put worker-only settings in .env.worker (gitignored):
#
#   openssl rand -base64 32 > data/bank_kek && chmod 400 data/bank_kek
#   echo "BANK_SYNC_KEK_FILE=./data/bank_kek" >> .env.worker
#   echo "BANK_SYNC_ALLOW_SANDBOX=1"          >> .env.worker   # accept sandbox apps
#   pnpm worker:dev
#
# Production: see deploy/docker-compose.example.yml (Docker secret, worker only).

# ── Push notifications (Web Push) ─────────────────────────
# Lets users get alerts on their phone or desktop (Settings → Notifications).
# Generate a key pair once and give BOTH the web app and the worker the same
# values (app.env is shared in production):
#
#   npx web-push generate-vapid-keys
#
# Unset = push is off; the settings page says so. The private key only
# authorises sending to subscriptions made with the public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at (mailto: or https:).
VAPID_SUBJECT=mailto:admin@yourdomain.com
# Time zone of the worker's morning notification run (08:00). Default Europe/Amsterdam.
# APP_TIMEZONE=Europe/Amsterdam
