{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/migrate.ts",
    "auth:generate": "npx @better-auth/cli generate --output ./src/db/auth-schema.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
