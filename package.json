{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/migrate.ts",
    "auth:generate": "npx @better-auth/cli generate --output ./src/db/auth-schema.ts",
    "start": "next start",
    "worker:dev": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.worker src/worker/main.ts",
    "worker:build": "esbuild src/worker/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.mjs --external:@libsql/client --external:libsql --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/db-init.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/finance.db && npm run db:migrate && npm run db:seed && echo '\\nDatabase reset. Restart the dev server if it is running.'",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.78.0",
    "@sentry/node": "10.78.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/ui": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
